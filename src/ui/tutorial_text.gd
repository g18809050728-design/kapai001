class_name UiTutorialText
extends RefCounted
##
## 界面文案（教学 / 规则说明）—— **不是规则**，不含任何数值判定，也不读 ContentDB。
##
## 《统一设计文档》§4 的叙事 NPC 分工：辅导员周岚负责节点教学，助教陈澄负责规则解释。
## 本文件只提供这两位的台词与分步说明；页面的可达性与可用性仍由 GameShell 的门控决定。
##
## 文案边界：这里写「怎么用界面」和「这一步会发生什么」，不写具体数值（数值以内容层为准，
## 界面上该显示数字的地方一律读视图字段），避免文案与 data/ 漂移。
##

const GUIDE_NODE := "辅导员周岚"
const GUIDE_RULES := "助教陈澄"


## 教学章节：每节一个标题 + 周岚的台词 + 分步要点。章节 id 也用于「按场景提示」。
static func sections() -> Array:
	return [
		{
			"id": "map",
			"title": "一、地图与节点",
			"guide": GUIDE_NODE,
			"line": "一学期六个节点：普通作业 → 分支 → 商店 → 普通或精英 → 休息 → 期末大作业。只能向前走，别回头。",
			"steps": [
				"地图上写着「可进入」的节点才是这一步能选的；灰掉的是不可达或已完成的。",
				"第 2 层是二选一（突发事件或普通作业），第 4 层是普通或精英，两条路都通向第 6 层。",
				"点节点就进入它；每进入一次就会消耗精力，精力归零这一局就结束了。",
			],
		},
		{
			"id": "battle",
			"title": "二、战斗（出牌 / 专注 / 精力 / DDL）",
			"guide": GUIDE_NODE,
			"line": "作业战斗就三件事：把手牌打完任务进度、别让 DDL 跑完、别把精力花光。",
			"steps": [
				"每回合有固定专注，出牌要花专注；出牌前可以先看卡面右侧的精力代价（有代价的牌会红字标出）。",
				"任务卡上的进度条是「完成度」，DDL 是回合倒计时；两项都看住。",
				"按钮灰掉不是坏了——那是规则层说「现在不能提交」，鼠标也点不动。",
				"战斗界面里有「规则」和「日志」入口，随时可以看这一场发生了什么。",
			],
		},
		{
			"id": "reward",
			"title": "三、奖励",
			"guide": GUIDE_NODE,
			"line": "打完作业有奖励：卡牌或饰品二选一，处理完才能离开节点。",
			"steps": [
				"候选在进入奖励页时就冻结了，反复看不会换牌。",
				"饰品槽满时要先选一个要替换掉的旧饰品。",
				"不需要的奖励可以跳过（写着「跳过这一项」的项才允许跳过）。",
			],
		},
		{
			"id": "shop",
			"title": "四、商店",
			"guide": GUIDE_NODE,
			"line": "商店卖卡和饰品，也能花钱删掉一张牌——删牌价格每次都会涨。",
			"steps": [
				"买不起的货按不动；钱不够时按钮是灰的。",
				"删牌每店一次，牌组不能少于下限。",
				"随时可以「离开商店」，不需要买东西。",
			],
		},
		{
			"id": "event",
			"title": "五、突发事件",
			"guide": GUIDE_NODE,
			"line": "突发事件里每个选项都得选一个才走得掉；不想冒险就选「离开，无变化」。",
			"steps": [
				"选项上写了成本（钱 / 精力）；付不起的选项会灰掉并写明原因。",
				"有的选项要你再挑一张牌（升级 / 删除）或一个候选，挑完才算结算。",
				"结算之后「离开事件」才会亮。",
			],
		},
		{
			"id": "rest",
			"title": "六、休息",
			"guide": GUIDE_NODE,
			"line": "休息四选一：回精力、升级一张牌、删一张负担牌、训练一张合作牌。",
			"steps": [
				"先做一件事，「休息完毕，继续」才会亮。",
				"升级 / 删牌 / 训练要点一张具体的牌，非法目标（已满级、不是负担、不是合作牌）按不动。",
			],
		},
		{
			"id": "term",
			"title": "七、学期结算",
			"guide": GUIDE_NODE,
			"line": "打完期末大作业就进学期结算：先选一张方向奖励，第 5 学期开始前还要定履历方向。",
			"steps": [
				"结算期间不能进节点，处理完自动进入下一学期。",
				"方向奖励可以跳过；履历方向不可跳过。",
			],
