		{
			"id": "save",
			"title": "八、保存 / 继续 / 失败重开",
			"guide": GUIDE_NODE,
			"line": "每一步都会自动存。中途退出可以「继续上一局」；精力归零或 DDL 超时会进结算页，可以立刻重开。",
			"steps": [
				"主菜单的「继续上一局」读的是正式档；正式档坏了会自动退回备份档（状态栏会说明）。",
				"设置页可以关掉自动存档、改默认难度与种子，也能从备份恢复。",
				"局终（胜利 / 失败 / 放弃）都会写进人物档案，失败也能攒解锁。",
			],
		},
	]


## 按当前场景给一句提示（周岚）。返回空串表示这一屏不给提示。
static func hint_for_screen(screen: String, node_kind: String = "") -> String:
	match screen:
		"map":
			match node_kind:
				"normal":
					return "%s：先挑「可进入」的节点。普通作业是稳的主线，注意 DDL。" % GUIDE_NODE
				"event":
					return "%s：第 2 层的事件可以选「离开，无变化」，风险自负。" % GUIDE_NODE
				"shop":
					return "%s：钱留着也好，删牌价格会越来越贵。" % GUIDE_NODE
				"rest":
					return "%s：牌组还没成型就优先回精力，成型了就升级关键牌。" % GUIDE_NODE
				"elite", "boss":
					return "%s：精英和期末大作业会难一截，进去前先看看精力。" % GUIDE_NODE
			return "%s：六层路只能向前；每进一个节点都会掉精力。" % GUIDE_NODE
		"battle":
			return "%s：专注花在刀刃上——先算任务进度，再看 DDL。" % GUIDE_NODE
		"reward":
			return "%s：候选进入时就冻结了，能拿到就先拿着。" % GUIDE_NODE
		"rest":
			return "%s：休息只有一次机会，用在你现在最缺的东西上。" % GUIDE_NODE
	return ""


## 规则说明页的分节（陈澄）。与《统一设计文档》的章节号对应，方便玩家回查。
static func rule_sections() -> Array:
	return [
		{"title": "目标", "lines": [
			"一学期六个节点：普通作业 / 分支 / 商店 / 普通或精英 / 休息 / 期末大作业。走完第 6 层并处理学期结算，就算「第一学期完成」。",
			"精力归零或 DDL 超时这一局就结束；精力在学期之间会按上限百分比恢复。",
		]},
		{"title": "战斗回合", "lines": [
			"一回合依次是：准备（清放松、算专注）→ 抽牌 → 玩家行动 → 同学行动 → 弃牌 → 敌人准备 → 敌人技能 → 敌人压力 → 回合结束。",
			"出牌要花专注；有的牌还要额外支付精力（卡面右侧红字），支付的精力绕过放松直接扣。",
			"任务有「完成度」和「DDL」：打满完成度就完成，DDL 走完算超时。",
		]},
		{"title": "意图与待选", "lines": [
			"敌人的每个意图在技能/压力阶段结算；点名式压力会先打在指定目标上。",
			"有的效果会先让你从手牌里选（例如抽后弃、从弃牌堆回收）；待选期间其它操作一律不可提交。",
			"取消目标 / 换人不会消耗行动，提交前的所有选择都只是草稿。",
		]},
		{"title": "节点与代价", "lines": [
