[Unit]
Description=Expire Kapai staging stats and sessions
After=kapai-mysql.service
Wants=kapai-mysql.service

[Service]
Type=oneshot
DynamicUser=yes
WorkingDirectory=/opt/kapai001/server
EnvironmentFile=/etc/kapai001/stage-app.env
EnvironmentFile=/etc/kapai001/stage-api.env
ExecStart=/opt/kapai-api-venv/bin/python -m kapai.manage prune
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
