[Unit]
Description=Kapai production account and cloud API
After=kapai-mysql.service
Wants=kapai-mysql.service

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/kapai-api/releases/20261121-admin-developer-tools
EnvironmentFile=/etc/kapai001/prod-app.env
EnvironmentFile=/etc/kapai001/prod-api.env
ExecStart=/opt/kapai-api-venv/bin/uvicorn kapai.main:api --host 127.0.0.1 --port 18445 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
