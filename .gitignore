# Godot generated cache and translations.
# Keep *.import settings and *.gd.uid files under version control.
.godot/
.import/
*.translation

# Local builds and export credentials.
/build/
/builds/
/dist/
/export/
/exports/
/export_credentials.cfg

# Player data must never travel with source downloads or exports.
/saves/
/user_data/
**/current_run.json
**/current_run.json.bak*
**/current_run.json.tmp

# Python bytecode, tool caches and virtual environments.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.venv/
venv/
env/

# Local code index and editor settings.
.codegraph/
.idea/
.vscode/
.codex/
.claude/

# Local environment values; allow shareable templates.
.env
.env.*
!.env.example
!.env.sample

# OS and editor temporary files.
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Re-creatable test reports and local coverage output.
.coverage
.coverage.*
coverage/
htmlcov/
test-results/
test-output/
junit.xml
junit-*.xml

# Ad hoc project archive created for local transfer.
/docs.zip

# AI assistant scratch space and temporary artifacts.
.ai-work/
.ai-scratch/
.agent-work/
/artifacts/ai-work/
/artifacts/ai-intermediate/
artifacts/**/scratch/
artifacts/**/tmp/
artifacts/**/temp/
artifacts/**/working/

# Local verification runs and downloaded research-page snapshots.
/artifacts/verification/*/

# AI authoring workspaces stay local; retain only final design deliverables.
/artifacts/cardpool40-20261029/
/artifacts/doc-sync-20261029/
/artifacts/redesign-20261029/*
!/artifacts/redesign-20261029/README.md
!/artifacts/redesign-20261029/source-manifest.json
!/artifacts/redesign-20261029/校园角色与专属卡池_v2.xlsx
!/artifacts/redesign-20261029/杀戮尖塔2_卡牌参考与流派分析.xlsx

# Project assets and existing historical verification evidence are deliverables.
agent.md
AGENTS.md
/.vs/kapai001/FileContentIndex
/.vs
